{
  "name": "stoicprayers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "typecheck": "react-router typegen && tsc",
    "test": "node --test tests/*.test.mjs",
    "preview": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.1",
    "prettier": "3.9.6",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
